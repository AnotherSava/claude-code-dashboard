# Node / Vite
node_modules
dist
dist-ssr
*.log
npm-debug.log*

# Rust / Tauri
src-tauri/target/
src-tauri/gen/schemas/

# OS
*.local

# Python
__pycache__/
*.pyc

# Plans: ignore in-flight plans in docs/plans/ itself;
# keep completed/ and draft/ tracked.
/docs/plans/*
!/docs/plans/completed/
!/docs/plans/draft/

# Deploy-time config, per machine. `local.template.json` is the secret-free
# source: its {{tojson .NAME}} placeholders are filled from the Doppler project
# and config named in `config/deploy.env`, and the global deploy script renders
# it straight into the installed config.json. A machine with no template keeps a
# plaintext `local.json`, which the deploy copies verbatim.
config/local.json
config/local.template.json

# Timestamped backups written by the cleanup skill before it wipes app data
# (BACKUP_FILES in config/deploy.env decides what gets saved).
.cleanup-backups/

# Local Jekyll build of the docs site. GitHub Pages builds from source and never
# reads any of these; they exist so the site can be looked at before it ships.
/docs/_site/
/docs/.jekyll-cache/
/docs/vendor/
/docs/.bundle/
