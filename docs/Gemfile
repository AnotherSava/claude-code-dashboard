# Builds this site the way GitHub Pages does, so the theme hooks, the Liquid in
# `_includes/figure.html` and the no-JS render can be looked at before they ship.
# GitHub Pages ignores this file — it resolves its own gem set — so the pin here
# exists to keep a local build honest rather than to configure the deploy.
source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins

# Windows and JRuby do not include zoneinfo files.
gem "tzinfo-data", platforms: [:windows, :jruby]

# jekyll-remote-theme needs openssl >= 3.1.2, and left free bundler locks the
# newest, which has no prebuilt Windows gem and must compile against MSYS2's
# OpenSSL. A Ruby whose default openssl gem is 3.2.4 (3.3.12 on the Windows
# box) installs nothing for this pin; any other Ruby, 3.4 included, downloads
# and compiles openssl 3.2.x instead.
gem "openssl", "~> 3.2.4"
